---
import { site } from "../data/site";
---

<a class="float" href={site.links.whatsappChannel} target="_blank" rel="noopener noreferrer">
  <span aria-hidden="true">&#x25C9;</span>
  <span class="label">Gabung WhatsApp</span>
</a>
<style>
  .float {
    position: fixed;
    right: 12px;
    bottom: calc(var(--bar-h) + env(safe-area-inset-bottom) + 12px);
    z-index: var(--z-float);
    min-width: 48px;
    min-height: 48px;
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 2px solid white;
    border-radius: 999px;
    background: var(--wa);
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 4px 14px rgb(60 8 16/0.4);
  }
  @media (max-width: 379px) {
    .label {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .float {
      bottom: 18px;
    }
  }
</style>
