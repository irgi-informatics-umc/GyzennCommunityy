---
import modpacksData from '../../public/assets/data/modpacks.json';
import siteData from '../../public/assets/data/site.json';

const { site } = siteData;
const latestModpacks = modpacksData
  .filter(m => (m.isNew || m.isRecommended) && !m.isArchived && m.type === 'modpack')
  .slice(0, 8);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-poster-box">
      <div class="footer-brand-title">GYZENN COMMUNITY</div>

      <p class="footer-desc">
        Komunitas kreator Minecraft Indonesia independen. Menyediakan modpack, shader rekomendasi, dan launcher Android terbaik untuk semua pemain.
      </p>

      <ul class="footer-links-grid">
        <li><a href="/">BERANDA</a></li>
        <li><a href="/komunitas/">KOMUNITAS</a></li>
        <li><a href="/komunitas/#discord">DISCORD COMMUNITY</a></li>
        <li><a href="/modpacks/">SEMUA MODPACKS</a></li>
        {latestModpacks.map(m => (
          <li><a href={`/modpacks/#${m.id}`}>{m.name.toUpperCase()}</a></li>
        ))}
        <li><a href="/zalith/">ZALITH LAUNCHER</a></li>
        <li><a href="/casda-network/">CASDA NETWORK</a></li>
        <li><a href="/#support">SUPPORT GYZENN</a></li>
        <li><a href={site.links.saweria} target="_blank" rel="noopener noreferrer" style="color: var(--color-pink);"><i class="fa-solid fa-heart"></i> SUPPORT ON SAWERIA</a></li>
        <li><a href={site.links.linktree} target="_blank" rel="noopener noreferrer">LINKTREE RESMI</a></li>
      </ul>

      <div class="footer-hr"></div>

      <div class="footer-bottom-row">
        <p>© 2026 GYZENN COMMUNITY. CREATED WITH <i class="fa-solid fa-heart" style="color: #FF2A85;"></i> FOR MINECRAFT GAMERS.</p>
        <p class="retro-pixel-text" style="font-size: 0.82rem;">DEVICE: {site.deviceSpec} • TESTED & BENCHMARKED</p>
      </div>
    </div>
  </div>
</footer>
