---
import { nav } from "../data/nav";
import { site } from "../data/site";
const path = Astro.url.pathname;
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="head">
  <a class="logo" href="/" aria-label="Gyzenn Community, beranda">
    <span class="cube" aria-hidden="true">
      &#x25C6;
    </span>{" "}
    GYZENN
  </a>
  <nav class="desktop" aria-label="Navigasi utama">
    {nav.map((n) => (
      <a
        class:list={{ current: active(n.href) }}
        aria-current={active(n.href) ? "page" : undefined}
        href={n.href}
      >
        {n.label}
      </a>
    ))}
  </nav>
  <a class="btn primary head-cta mobile-cta" href="/modpacks/">
    Unduh
  </a>
  <a
    class="btn discord head-cta desktop-cta"
    href={site.links.discord}
    target="_blank"
    rel="noopener noreferrer"
  >
    Gabung Discord
  </a>
</header>
<script>
  const sentinel = document.createElement("i");
  sentinel.className = "header-sentinel";
  document.body.prepend(sentinel);
  const header = document.querySelector(".head");
  new IntersectionObserver(([e]) =>
    header?.classList.toggle("scrolled", !e.isIntersecting),
  ).observe(sentinel);
</script>
<style>
  .head {
    position: sticky;
    top: 10px;
    z-index: var(--z-header);
    height: 60px;
    margin: 10px 12px 0;
    padding: 6px 9px 6px 16px;
    border-radius: 16px;
    background: var(--glass);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border: 1px solid rgb(255 255 255/0.5);
    transition: background 0.2s;
  }
  .head.scrolled {
    background: var(--glass-dark);
  }
  .logo {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    font-weight: 800;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .cube {
    font-size: 23px;
  }
  .desktop {
    display: none;
  }
  .head-cta {
    min-width: 90px;
  }
  .desktop-cta {
    display: none;
  }
  .header-sentinel {
    height: 1px;
    position: absolute;
    top: 0;
  }
  @supports not (backdrop-filter: blur(1px)) {
    .head {
      background: var(--bg-deep);
    }
  }
  @media (min-width: 1024px) {
    .head {
      max-width: var(--container);
      margin: 10px auto 0;
      padding-inline: 20px;
    }
    .desktop {
      display: flex;
      gap: 4px;
    }
    .desktop a {
      min-height: 48px;
      padding: 10px 12px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      font-weight: 600;
    }
    .desktop a.current,
    .desktop a:hover {
      background: rgb(255 255 255/0.2);
    }
    .head-cta {
      min-width: 160px;
    }
    .mobile-cta {
      display: none;
    }
    .desktop-cta {
      display: inline-flex;
    }
  }
</style>
