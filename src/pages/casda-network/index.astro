---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../../public/assets/data/site.json';
import '../../styles/pages/casda.css';

const { site } = siteData;
---
<BaseLayout 
  title="Casda Network - Official Minecraft Server Gyzenn Community"
  description="Casda Network Minecraft Server — Official Network Gyzenn Community. Java & Bedrock cross-platform (Coming Soon)."
>
  <section class="section section-server" id="server">
    <div class="container">

      <div class="section-header">
        <span class="section-tag tag-retro-orange">
          <i class="fa-solid fa-network-wired"></i> MINECRAFT SERVER
        </span>
        <h1 class="section-title">CASDA NETWORK</h1>
        <p class="section-desc">
          Official Minecraft Network dari Gyzenn Community. Saat ini sedang dalam tahap pengembangan intensif untuk menghadirkan pengalaman bermain terbaik.
        </p>
      </div>

      <div class="retro-poster-box server-poster">
        <div class="server-poster-grid">

          <div class="server-img-col">
            <div class="server-frame-wrapper" id="serverPosterFrame">
              <img src="/assets/img/casda.jpg" alt="Casda Network" class="server-img" loading="lazy" />
              <div class="server-badge-overlay"><i class="fa-solid fa-clock"></i> COMING SOON</div>
            </div>
          </div>

          <div class="server-info-col">
            <div class="server-badges-row">
              <span class="tag-badge tag-warning-pulse"><i class="fa-solid fa-hourglass-half"></i> UNDER DEVELOPMENT</span>
              <span class="tag-badge tag-mc-version"><i class="fa-solid fa-clock"></i> COMING SOON</span>
            </div>

            <h2 class="server-main-title">CASDA NETWORK</h2>
            <p class="server-desc">
              Casda Network sedang dalam tahap pengembangan. Berbagai sistem, mode, dan fitur server sedang dipersiapkan sebelum resmi dibuka untuk publik.
            </p>

            <div class="server-chips-grid">
              <div class="server-chip">
                <span class="chip-label">VERSION:</span>
                <span class="chip-val">TO BE ANNOUNCED</span>
              </div>
              <div class="server-chip chip-status">
                <span class="chip-label">STATUS:</span>
                <span class="chip-val status-val">🔨 IN DEVELOPMENT</span>
              </div>
              <div class="server-chip">
                <span class="chip-label">PLATFORM:</span>
                <span class="chip-val">Java + Bedrock</span>
              </div>
              <div class="server-chip chip-ip">
                <span class="chip-label">SERVER IP:</span>
                <span class="chip-val ip-text">SEGERA RILIS</span>
              </div>
            </div>

            <div class="server-modes-preview">
              <div class="mode-preview-card">
                <div class="mode-card-header">
                  <span class="mode-name"><i class="fa-solid fa-campground"></i> SURVIVAL</span>
                  <span class="mode-status-badge">COMING SOON</span>
                </div>
                <p class="mode-card-desc">Mode Survival Casda Network sedang dipersiapkan.</p>
              </div>
              <div class="mode-preview-card">
                <div class="mode-card-header">
                  <span class="mode-name"><i class="fa-solid fa-crosshairs"></i> PVP ARENA</span>
                  <span class="mode-status-badge">COMING SOON</span>
                </div>
                <p class="mode-card-desc">Mode PvP sedang dalam tahap development.</p>
              </div>
              <div class="mode-preview-card">
                <div class="mode-card-header">
                  <span class="mode-name"><i class="fa-solid fa-coins"></i> ECONOMY</span>
                  <span class="mode-status-badge">SEGERA RILIS</span>
                </div>
                <p class="mode-card-desc">Sistem ekonomi server sedang dirancang.</p>
              </div>
              <div class="mode-preview-card">
                <div class="mode-card-header">
                  <span class="mode-name"><i class="fa-solid fa-users"></i> COMMUNITY</span>
                  <span class="mode-status-badge">COMING SOON</span>
                </div>
                <p class="mode-card-desc">Fitur komunitas aktif setelah network rilis.</p>
              </div>
            </div>

            <div class="server-actions-group">
              <button type="button" class="btn btn-copy-ip" id="btnCopyIp" aria-label="IP Casda Network Segera Rilis">
                <i class="fa-solid fa-clock"></i>
                <span id="copyIpBtnText">IP SEGERA RILIS</span>
              </button>
              <a href={site.links.discordCasda} target="_blank" rel="noopener noreferrer" class="btn btn-discord-subtle" title="Gabung Discord Komunitas Gyzenn">
                <i class="fa-brands fa-discord"></i>
                <span>DISCORD COMMUNITY</span>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <script is:inline src="/assets/js/pages/casda.js" defer></script>
</BaseLayout>
