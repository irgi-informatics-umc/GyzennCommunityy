---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../../public/assets/data/site.json';
import '../styles/pages/home.css';

const { site } = siteData;
---
<BaseLayout 
  title="Gyzenn Community - Minecraft Creator, Modpack Hub & Casda Network"
  description="Official website Gyzenn Community — Minecraft creator Indonesia. Modpack Hub, DERIVATIVE Shader, Zalith Launcher, dan Casda Network Minecraft Server."
>
  <section class="hero-section" id="hero">
    <div class="container hero-container">
      <div class="hero-poster-layout">

        <div class="status-badge">
          <span class="pulse-dot"></span>
          <span class="retro-pixel-text">ONLINE • MINECRAFT CREATOR & COMMUNITY HUB</span>
        </div>

        <h1 class="hero-title">
          <span class="hero-word word-gyzenn">GYZENN</span>
          <span class="hero-word word-community">COMMUNITY</span>
        </h1>

        <div class="hero-tag-strip">
          <span class="sticker-tag"><i class="fa-solid fa-cube"></i> MINECRAFT CREATOR</span>
          <span class="sticker-tag tag-pink"><i class="fa-solid fa-wand-magic-sparkles"></i> SHADERS</span>
          <span class="sticker-tag tag-yellow"><i class="fa-solid fa-box-open"></i> MODPACKS</span>
        </div>

        <div class="hero-visual-center">
          <div class="retro-polaroid-frame" id="heroPolaroid">
            <div class="polaroid-header">
              <span class="polaroid-dots">● ● ●</span>
              <span class="polaroid-title">GYZENN CREATOR PROFILE</span>
            </div>

            <div class="avatars-wrapper">
              <div class="avatar-card avatar-wa-card" title="WhatsApp Channel Profile">
                <div class="avatar-ring wa-ring">
                  <img src="/assets/img/wa.jpg" alt="WhatsApp Profile" class="avatar-img" width="75" height="75" loading="eager" />
                </div>
                <span class="avatar-label"><i class="fa-brands fa-whatsapp"></i> WHATSAPP</span>
              </div>

              <div class="avatar-card avatar-tiktok-card" title="TikTok Creator Profile">
                <div class="avatar-ring tiktok-ring">
                  <img src="/assets/img/tiktok.jpeg" alt="TikTok Profile" class="avatar-img" width="75" height="75" loading="eager" />
                </div>
                <span class="avatar-label"><i class="fa-brands fa-tiktok"></i> TIKTOK</span>
              </div>
            </div>

            <div class="polaroid-caption">
              <span class="retro-handwriting">@giovmare • Official Gyzenn Hub</span>
            </div>
          </div>
        </div>

        <div class="hero-action-bottom">
          <div class="device-spec-pill" title="Hardware Specs">
            <i class="fa-solid fa-laptop-code"></i>
            <span>TESTED DEVICE: <strong>ACER NITRO V15</strong></span>
            <span class="gpu-badge">RTX 4050</span>
          </div>

          <div class="hero-cta-group">
            <a href={site.links.linktree} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-hero-main" id="btnHeroLinktree">
              <i class="fa-solid fa-tree"></i>
              <span>LINKTREE GUA</span>
            </a>
            <a href="/modpacks/" class="btn btn-secondary btn-hero-sub" id="btnHeroModpacks">
              <i class="fa-solid fa-download"></i>
              <span>EXPLORE MODPACK</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <div class="retro-ribbon-divider" aria-hidden="true"></div>

  {/* Page Navigation Teasers */}
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag tag-retro-pink">
          <i class="fa-solid fa-compass"></i> NAVIGASI QUICK ACCESS
        </span>
        <h2 class="section-title">JELAJAHI GYZENN COMMUNITY</h2>
        <p class="section-desc">Pilih halaman yang ingin kamu tuju untuk modpack, komunitas, launcher, atau server.</p>
      </div>

      <div class="home-teaser-grid">
        <div class="teaser-card">
          <div class="teaser-card-icon" style="background-color: var(--color-pink); color: #fff;">
            <i class="fa-solid fa-users"></i>
          </div>
          <h3 class="teaser-card-title">KOMUNITAS & DISCORD</h3>
          <p class="teaser-card-desc">TikTok score, Saluran WhatsApp, Group Mabar, dan Discord Hub 24/7.</p>
          <a href="/komunitas/" class="btn btn-primary" style="font-size: 0.8rem; padding: 0.5rem;">BUKA KOMUNITAS</a>
        </div>

        <div class="teaser-card">
          <div class="teaser-card-icon" style="background-color: var(--color-yellow); color: #121212;">
            <i class="fa-solid fa-box-open"></i>
          </div>
          <h3 class="teaser-card-title">MODPACKS & SHADER</h3>
          <p class="teaser-card-desc">DERIVATIVE Shader, Survival V2, Cobra Remake Series, FpsBoost & CPvP.</p>
          <a href="/modpacks/" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.5rem;">LIHAT MODPACKS</a>
        </div>

        <div class="teaser-card">
          <div class="teaser-card-icon" style="background-color: var(--color-blue); color: #fff;">
            <i class="fa-solid fa-rocket"></i>
          </div>
          <h3 class="teaser-card-title">ZALITH LAUNCHER</h3>
          <p class="teaser-card-desc">Rilis 1.4.1.4 by MovTery, changelog lengkap & download APK Android.</p>
          <a href="/zalith/" class="btn btn-primary" style="font-size: 0.8rem; padding: 0.5rem;">DOWNLOAD ZALITH</a>
        </div>

        <div class="teaser-card">
          <div class="teaser-card-icon" style="background-color: var(--color-orange); color: #fff;">
            <i class="fa-solid fa-server"></i>
          </div>
          <h3 class="teaser-card-title">CASDA NETWORK</h3>
          <p class="teaser-card-desc">Official Minecraft Network Gyzenn Community (Under Development).</p>
          <a href="/casda-network/" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.5rem;">CEK CASDA NETWORK</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Campaign Section -->
  <section class="section section-support-campaign" id="support">
    <div class="container">
      <div class="support-campaign-wrapper">
        <div class="campaign-shape shape-starburst" aria-hidden="true">★</div>
        <div class="campaign-shape shape-squiggle" aria-hidden="true">
          <svg width="70" height="24" viewBox="0 0 70 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 12C8 4 14 20 20 12C26 4 32 20 38 12C44 4 50 20 56 12C62 4 68 20 68 12" stroke="#FF5722" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="campaign-shape shape-dots-cluster" aria-hidden="true"></div>

        <div class="support-campaign-grid">
          <div class="support-typography-col">
            <div class="support-tag-row">
              <span class="section-tag tag-retro-pink">
                <i class="fa-solid fa-heart"></i> SUPPORT THE COMMUNITY
              </span>
              <span class="tag-badge tag-shader">
                <i class="fa-solid fa-mug-hot"></i> SAWERIA // GIIPRTMA
              </span>
            </div>

            <h2 class="support-giant-title">
              SUPPORT<br>
              <span class="highlight-yellow">GYZENN</span>
            </h2>

            <p class="support-editorial-lead">
              Enjoying the community, modpacks and projects? Help us keep Gyzenn growing, servers active, and regular optimization updates coming for everyone.
            </p>

            <div class="support-meta-tags">
              <span class="tag-badge tag-mc-version"><i class="fa-solid fa-bolt"></i> CREATOR SUPPORT</span>
              <span class="tag-badge tag-fabric"><i class="fa-solid fa-qrcode"></i> QRIS & E-WALLET</span>
              <span class="tag-badge tag-release"><i class="fa-solid fa-star"></i> 100% COMMUNITY DRIVEN</span>
            </div>
          </div>

          <div class="support-visual-col">
            <div class="support-sticker-physical">
              <span class="sticker-heart-icon">♥</span>
              <span>KEEP GYZENN GROWING</span>
            </div>

            <div class="saweria-editorial-poster">
              <div class="poster-badge-top">
                <span>SAWERIA OFFICIAL</span>
                <span class="poster-dot">●</span>
                <span>GYZENN</span>
              </div>

              <div class="poster-center-box">
                <div class="poster-sub-label">MINECRAFT CREATOR SUPPORT</div>
                <h3 class="poster-headline">DUKUNG<br>GYZENN</h3>
                <p class="poster-caption">
                  Dukunganmu membantu kelangsungan modpack, optimasi FPS, dan server komunitas.
                </p>
              </div>

              <div class="poster-cta-box">
                <a href={site.links.saweria} target="_blank" rel="noopener noreferrer" class="btn btn-saweria-editorial btn-saweria-burst" id="btnSaweriaCta" aria-label="Support Gyzenn on Saweria">
                  <i class="fa-solid fa-heart"></i>
                  <span>SUPPORT ON SAWERIA</span>
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
                <span class="poster-direct-url">saweria.co/GiiPrtma</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="/assets/js/pages/home.js" defer></script>
</BaseLayout>
