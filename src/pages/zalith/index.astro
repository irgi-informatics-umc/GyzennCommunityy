---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { zalith } from "../../data/zalith";
const primary = zalith.apks.find((a) => a.arch === "arm64-v8a")!;
---

<BaseLayout
  title={`Zalith Launcher ${zalith.version} untuk Android &mdash; Gyzenn Community`}
  description={`Unduh Zalith Launcher ${zalith.version} oleh ${zalith.developer} untuk Android.`}
>
  <div class="container page">
    <h1>Zalith Launcher {zalith.version}</h1>
    <p>
      {zalith.title} oleh {zalith.developer}. {zalith.subtitle}
    </p>
    <h2>Tiga langkah memulai</h2>
    <div class="steps">
      <div class="card">
        <b>1</b>
        <p>Pilih tipe perangkat.</p>
      </div>
      <div class="card">
        <b>2</b>
        <p>Unduh APK yang sesuai.</p>
      </div>
      <div class="card">
        <b>3</b>
        <p>Pasang APK. Izinkan sumber tidak dikenal jika diminta.</p>
      </div>
    </div>
    <section class="card recommended">
      <div>
        <span class="label">Rekomendasi</span>
        <h2>arm64-v8a</h2>
        <p>
          {primary.description} &middot; {primary.size}
        </p>
      </div>
      <a class="btn primary" href={primary.url} target="_blank" rel="noopener noreferrer">
        Unduh APK
      </a>
      <a class="universal" href="#universal">
        Tidak yakin? Pakai versi Universal
      </a>
    </section>
    <h2>Semua file APK</h2>
    <div class="apk-list">
      {zalith.apks.map((apk) => (
        <article
          class:list={["card", "apk", apk.universal ? "highlight" : ""]}
          id={apk.universal ? "universal" : undefined}
        >
          <div class="symbol">&#x25C8;</div>
          <div class="apk-info">
            <strong>{apk.filename}</strong>
            <p>{apk.description}</p>
            <small>
              {apk.size} &middot; {apk.arch}
            </small>
          </div>
          <a class="btn primary" href={apk.url} target="_blank" rel="noopener noreferrer">
            Unduh
          </a>
        </article>
      ))}
    </div>
    <details class="changelog">
      <summary>Catatan perubahan ({zalith.version})</summary>
      <ul>
        {zalith.changelog.map((c) => (
          <li>
            <b>{c.title}:</b> {c.text}
          </li>
        ))}
      </ul>
    </details>
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: zalith.title,
      softwareVersion: zalith.version,
      operatingSystem: "Android",
      applicationCategory: "GameApplication",
      downloadUrl: zalith.apks.map((a) => a.url),
    })}
  />
</BaseLayout>
<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .steps .card {
    padding: 16px;
    color: var(--ink);
  }
  .steps b {
    display: grid;
    place-items: center;
    background: #dceeff;
    color: var(--brand);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 19px;
  }
  .steps p {
    margin: 8px 0 0;
  }
  .recommended {
    padding: 18px;
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink);
  }
  .recommended p {
    margin: 0;
  }
  .label {
    font-size: 12px;
    font-weight: 700;
    color: var(--ok);
  }
  .universal {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--brand);
    font-weight: 600;
  }
  .apk-list {
    display: grid;
    gap: 10px;
  }
  .apk {
    padding: 13px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    align-items: center;
  }
  .highlight {
    background: #e8f5ff;
  }
  .symbol {
    font-size: 25px;
    color: var(--brand);
  }
  .apk-info {
    min-width: 0;
  }
  .apk-info strong {
    font:
      12px ui-monospace,
      monospace;
    overflow-wrap: anywhere;
  }
  .apk-info p {
    margin: 4px 0;
    font-size: 13px;
  }
  .apk-info small {
    color: var(--muted);
  }
  .apk > .btn {
    grid-column: 1/-1;
  }
  .changelog {
    margin-top: 22px;
    padding: 15px;
    background: white;
    color: var(--ink);
    border-radius: 14px;
  }
  .changelog summary {
    font-weight: 700;
    min-height: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
    .recommended {
      display: grid;
      grid-template-columns: 1fr auto;
    }
    .recommended .universal {
      grid-column: 1;
    }
    .apk {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .apk > .btn {
      grid-column: auto;
    }
  }
</style>
